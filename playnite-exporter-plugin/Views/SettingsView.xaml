<UserControl x:Class="PlayniteExporterPlugin.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cfg="clr-namespace:PlayniteExporterPlugin.Configuration"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="650">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" d:DataContext="{d:DesignInstance cfg:ExporterSettingsViewModel}">

            <!-- SECTION 1: Storage Destination -->
            <TextBlock Text="Storage Destination" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Border BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <!-- OPTION 1: Google Drive Desktop / Local Folder Sync (Recommended) -->
                    <RadioButton Content="Google Drive Desktop / Local Sync (Recommended — Zero API Setup)"
                                 IsChecked="{Binding Settings.StorageType, Converter={x:Static cfg:EnumBooleanConverter.Instance}, ConverterParameter=LocalFolder}"
                                 Margin="0,0,0,4" FontWeight="SemiBold" />
                    
                    <StackPanel Margin="24,2,0,14" IsEnabled="{Binding Settings.StorageType, Converter={x:Static cfg:EnumBooleanConverter.Instance}, ConverterParameter=LocalFolder}">
                        <TextBlock Text="If you run Google Drive for Desktop, OneDrive, Nextcloud, or Syncthing, simply select your synced folder (e.g. G:\My Drive\PlayniteSync). Files sync automatically in the background with ZERO Google Cloud API keys or setup required!"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,8" FontSize="12" />
                        <DockPanel Margin="0,0,0,4">
                            <Button Content="Browse Folder..." Command="{Binding SelectLocalFolderCommand}" DockPanel.Dock="Right" Padding="12,4" Margin="8,0,0,0" />
                            <TextBox Text="{Binding Settings.LocalFolderPath, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>

                    <Separator Margin="0,4,0,14" />

                    <!-- OPTION 2: Direct Google Drive Cloud API -->
                    <RadioButton Content="Direct Google Drive Cloud API (OAuth2 Connection)"
                                 IsChecked="{Binding Settings.StorageType, Converter={x:Static cfg:EnumBooleanConverter.Instance}, ConverterParameter=GoogleDrive}"
                                 Margin="0,0,0,4" FontWeight="SemiBold" />
                    
                    <StackPanel Margin="24,2,0,4" IsEnabled="{Binding Settings.StorageType, Converter={x:Static cfg:EnumBooleanConverter.Instance}, ConverterParameter=GoogleDrive}">
                        <TextBlock Text="Directly uploads to Google Drive via Google's REST API. Uses strictly least-privilege permission (drive.file scope): the extension ONLY has access to files it creates, and cannot access any other files in your Google Drive."
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,10" FontSize="12" />

                        <!-- Google Drive Authentication Status: Connected -->
                        <Border Visibility="{Binding ConnectedVisibility}"
                                Background="#1A3826" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="4"
                                Padding="12,8" Margin="0,0,0,10">
                            <DockPanel LastChildFill="True">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="#4CAF50" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding GoogleAuthStatusText}" FontWeight="SemiBold" Foreground="#81C784" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="📱 Copy Mobile Pairing Code" Command="{Binding CopyMobilePairingPayloadCommand}" Margin="0,0,8,0" Padding="12,4" FontWeight="SemiBold" Background="#2E7D32" Foreground="White" ToolTip="Copies an encrypted pairing code for instant connection in the Mobile Companion app." />
                                    <Button Content="Re-authenticate" Command="{Binding ConnectGoogleDriveCommand}" Margin="0,0,8,0" Padding="12,4" />
                                    <Button Content="Disconnect" Command="{Binding DisconnectGoogleDriveCommand}" Padding="12,4" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Google Drive Authentication Status: Not Connected -->
                        <Border Visibility="{Binding NotConnectedVisibility}"
                                Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" CornerRadius="4"
                                Padding="12,8" Margin="0,0,0,10">
                            <DockPanel LastChildFill="True">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="#888888" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding GoogleAuthStatusText}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrushDarker}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Content="Connect Google Drive Account" Command="{Binding ConnectGoogleDriveCommand}" HorizontalAlignment="Right" Padding="12,4" />
                            </DockPanel>
                        </Border>

                        <TextBlock Text="Target Drive Folder Name in Google Drive:" Margin="0,0,0,2" />
                        <TextBox Text="{Binding Settings.GoogleDriveFolderName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                        <Border Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,4">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Google Cloud OAuth2 Credentials" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Hyperlink Command="{Binding OpenGoogleGuideCommand}">
                                            <Run Text="Open Google Cloud Console" />
                                        </Hyperlink>
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Text="Create an OAuth 2.0 Client ID (Application type: Desktop app) in Google Cloud Console, enable Google Drive API, and paste your credentials below:"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,8" FontSize="11" />

                                <TextBlock Text="Google Client ID:" Margin="0,0,0,2" />
                                <TextBox Text="{Binding Settings.GoogleClientId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                                <TextBlock Text="Google Client Secret:" Margin="0,0,0,2" />
                                <PasswordBox Name="ClientSecretBox" Margin="0,0,0,4" PasswordChanged="ClientSecretBox_PasswordChanged" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- SECTION 2: Automated Delta Sync Triggers -->
            <TextBlock Text="Automated Delta Sync Triggers" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Border BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox Content="Sync on Game Exit (OnGameStopped - Instant O(1) single-game atomic delta sync)"
                              IsChecked="{Binding Settings.AutoSyncOnGameStopped}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="Sync on Library Update (OnLibraryUpdated - Bulk incremental delta sync)"
                              IsChecked="{Binding Settings.AutoSyncOnLibraryUpdated}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="Sync on Playnite Startup"
                              IsChecked="{Binding Settings.AutoSyncOnStartup}"
                              Margin="0,0,0,4" />
                </StackPanel>
            </Border>

            <!-- SECTION 3: Media Synchronization Policy -->
            <TextBlock Text="Media Synchronization Policy" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Border BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox Content="Sync Game Covers (Deduplicated Content-Addressable WebP/JPG)"
                              IsChecked="{Binding Settings.SyncCovers}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="Sync Game Backgrounds (Fanart / Hero Artwork)"
                              IsChecked="{Binding Settings.SyncBackgrounds}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="Sync Transparent Game Logos (ExtraMetadata PNG)"
                              IsChecked="{Binding Settings.SyncLogos}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="Sync Microtrailers (Lightweight 6-second 60fps MP4 loops, ~2 MB each)"
                              IsChecked="{Binding Settings.SyncMicrotrailers}"
                              Margin="0,0,0,8" />
                    <CheckBox Content="Sync Full Cinematic Trailers (HD video ~40 MB - Not recommended for cloud sync)"
                              IsChecked="{Binding Settings.SyncTrailers}"
                              Margin="0,0,0,4" />
                </StackPanel>
            </Border>

            <!-- SECTION 4: Network & Quotas -->
            <TextBlock Text="Network &amp; Performance" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Border BorderBrush="{DynamicResource NormalBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Max Parallel Upload Connections (1-8):" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Settings.MaxParallelUploads, UpdateSourceTrigger=PropertyChanged}"
                                 Width="50" HorizontalAlignment="Right" TextAlignment="Center" />
                    </DockPanel>
                    <CheckBox Content="Enable Orphan Pruning (Trash unreferenced remote assets when games/media are deleted)"
                              IsChecked="{Binding Settings.EnableOrphanPruning}"
                              Margin="0,0,0,4" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
