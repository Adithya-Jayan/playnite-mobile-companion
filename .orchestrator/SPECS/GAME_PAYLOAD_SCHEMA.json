{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playnite-delta-sync.internal/schemas/game_payload.json",
  "title": "UnifiedGamePayload",
  "description": "Unified per-game payload schema for Playnite Delta-Sync, consolidating core game metadata, media references, and extensible addon data.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "game_id",
    "plugin_id",
    "name",
    "sorting_name",
    "playtime_seconds",
    "play_count",
    "is_installed",
    "hidden",
    "favorite",
    "media",
    "addons"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version of this payload format.",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Internal Playnite Game GUID (UUID v4)."
    },
    "game_id": {
      "type": "string",
      "description": "Provider/Store external game identifier (e.g. Steam AppID '921800')."
    },
    "plugin_id": {
      "type": "string",
      "format": "uuid",
      "description": "GUID of the Playnite Library Plugin managing this title."
    },
    "name": {
      "type": "string",
      "description": "Game display title."
    },
    "sorting_name": {
      "type": "string",
      "description": "Normalized title used for alphabetical sorting."
    },
    "description": {
      "type": ["string", "null"],
      "description": "Full HTML or plain-text game description."
    },
    "notes": {
      "type": ["string", "null"],
      "description": "User private custom notes."
    },
    "playtime_seconds": {
      "type": "integer",
      "minimum": 0,
      "description": "Total elapsed playtime stored strictly in seconds."
    },
    "play_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of times the game has been launched."
    },
    "added_utc": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp when game was imported."
    },
    "modified_utc": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp when game metadata was last updated."
    },
    "last_activity_utc": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of last played session conclusion."
    },
    "recent_activity_utc": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp used for recent activity grouping."
    },
    "release_date": {
      "type": ["string", "null"],
      "description": "Official game release date (YYYY-MM-DD or partial string)."
    },
    "is_installed": {
      "type": "boolean",
      "description": "Whether the game is currently installed locally."
    },
    "install_directory": {
      "type": ["string", "null"],
      "description": "Local installation directory on the host machine."
    },
    "install_size_bytes": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Installed size on disk in bytes."
    },
    "hidden": {
      "type": "boolean",
      "description": "Whether the game is hidden in user's library."
    },
    "favorite": {
      "type": "boolean",
      "description": "Whether the game is marked as favorite/starred."
    },
    "version": {
      "type": ["string", "null"],
      "description": "Reported game version string."
    },
    "user_score": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 100,
      "description": "User custom rating out of 100."
    },
    "critic_score": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 100,
      "description": "Critic score (e.g. Metacritic/OpenCritic) out of 100."
    },
    "community_score": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 100,
      "description": "Community user score percentage out of 100."
    },
    "source": {
      "type": ["object", "null"],
      "description": "Primary store or import source entity.",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" }
      }
    },
    "completion_status": {
      "type": ["object", "null"],
      "description": "Progression completion state.",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string" }
      }
    },
    "platforms": {
      "type": "array",
      "description": "Hardware platforms associated with this game.",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "spec_id": { "type": ["string", "null"] }
        }
      }
    },
    "genres": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" }
        }
      }
    },
    "developers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" }
        }
      }
    },
    "publishers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" }
        }
      }
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" }
        }
      }
    },
    "age_ratings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" }
        }
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "media": {
      "type": "object",
      "description": "Cryptographic content-addressable and canonical media pointers.",
      "required": ["cover", "background", "icon", "logo", "microtrailer", "trailer"],
      "properties": {
        "cover": {
          "type": ["object", "null"],
          "properties": {
            "relative_path": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "format": { "type": "string", "enum": ["webp", "jpg", "png"] },
            "width": { "type": ["integer", "null"] },
            "height": { "type": ["integer", "null"] }
          },
          "required": ["relative_path", "sha256", "format"]
        },
        "background": {
          "type": ["object", "null"],
          "properties": {
            "relative_path": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "format": { "type": "string", "enum": ["webp", "jpg", "png"] },
            "width": { "type": ["integer", "null"] },
            "height": { "type": ["integer", "null"] }
          },
          "required": ["relative_path", "sha256", "format"]
        },
        "icon": {
          "type": ["object", "null"],
          "properties": {
            "relative_path": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "format": { "type": "string", "enum": ["png", "ico", "webp"] }
          },
          "required": ["relative_path", "sha256", "format"]
        },
        "logo": {
          "type": ["object", "null"],
          "description": "Transparent PNG title logo from ExtraMetadata.",
          "properties": {
            "relative_path": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "width": { "type": ["integer", "null"] },
            "height": { "type": ["integer", "null"] }
          },
          "required": ["relative_path", "sha256"]
        },
        "microtrailer": {
          "type": ["object", "null"],
          "description": "6-second 60fps MP4 looping video preview (~2 MB).",
          "properties": {
            "relative_path": { "type": "string" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "size_bytes": { "type": "integer" },
            "duration_seconds": { "type": "number" }
          },
          "required": ["relative_path", "sha256", "size_bytes"]
        },
        "trailer": {
          "type": ["object", "null"],
          "description": "Full cinematic trailer (on-demand streaming only).",
          "properties": {
            "relative_path": { "type": ["string", "null"] },
            "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
            "size_bytes": { "type": ["integer", "null"] },
            "duration_seconds": { "type": ["number", "null"] },
            "web_url": { "type": ["string", "null"], "format": "uri" }
          }
        }
      }
    },
    "addons": {
      "type": "object",
      "description": "Modular, decoupled container for addon data payloads. Forward/backward compatible and resilient to addon additions or removals.",
      "additionalProperties": true,
      "properties": {
        "success_story": {
          "type": ["object", "null"],
          "description": "Achievements data from SuccessStory addon.",
          "required": [
            "has_achievements",
            "total_count",
            "unlocked_count",
            "locked_count",
            "unlocked_percentage",
            "items"
          ],
          "properties": {
            "has_achievements": { "type": "boolean" },
            "total_count": { "type": "integer", "minimum": 0 },
            "unlocked_count": { "type": "integer", "minimum": 0 },
            "locked_count": { "type": "integer", "minimum": 0 },
            "unlocked_percentage": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
            "gamerscore_current": { "type": "number" },
            "gamerscore_total": { "type": "number" },
            "last_refresh_utc": { "type": ["string", "null"], "format": "date-time" },
            "estimate_time_min": { "type": ["integer", "null"] },
            "estimate_time_max": { "type": ["integer", "null"] },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "api_name",
                  "description",
                  "url_unlocked",
                  "url_locked",
                  "percent",
                  "is_hidden"
                ],
                "properties": {
                  "name": { "type": "string" },
                  "api_name": { "type": "string" },
                  "description": { "type": "string" },
                  "url_unlocked": { "type": "string" },
                  "url_locked": { "type": "string" },
                  "date_unlocked_utc": { "type": ["string", "null"], "format": "date-time" },
                  "percent": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
                  "gamerscore": { "type": "number" },
                  "is_hidden": { "type": "boolean" },
                  "category": { "type": "string" },
                  "progression": {
                    "type": ["object", "null"],
                    "properties": {
                      "min": { "type": "number" },
                      "max": { "type": "number" },
                      "value": { "type": "number" }
                    },
                    "required": ["min", "max", "value"]
                  }
                }
              }
            }
          }
        },
        "how_long_to_beat": {
          "type": ["object", "null"],
          "description": "Playtime estimates from HowLongToBeat addon (all durations in seconds).",
          "required": [
            "has_data",
            "main_story_seconds",
            "main_extra_seconds",
            "completionist_seconds"
          ],
          "properties": {
            "has_data": { "type": "boolean" },
            "hltb_id": { "type": ["string", "null"] },
            "url": { "type": ["string", "null"], "format": "uri" },
            "main_story_seconds": { "type": "integer", "minimum": 0 },
            "main_extra_seconds": { "type": "integer", "minimum": 0 },
            "completionist_seconds": { "type": "integer", "minimum": 0 },
            "solo_seconds": { "type": "integer", "minimum": 0 },
            "coop_seconds": { "type": "integer", "minimum": 0 },
            "vs_seconds": { "type": "integer", "minimum": 0 }
          }
        },
        "game_activity": {
          "type": ["object", "null"],
          "description": "Detailed play session logs and statistics from GameActivity addon.",
          "required": [
            "has_sessions",
            "total_tracked_seconds",
            "session_count",
            "sessions"
          ],
          "properties": {
            "has_sessions": { "type": "boolean" },
            "total_tracked_seconds": { "type": "integer", "minimum": 0 },
            "session_count": { "type": "integer", "minimum": 0 },
            "sessions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["date_session_utc", "elapsed_seconds"],
                "properties": {
                  "date_session_utc": { "type": "string", "format": "date-time" },
                  "elapsed_seconds": { "type": "integer", "minimum": 0 },
                  "source_id": { "type": ["string", "null"], "format": "uuid" },
                  "platform_ids": {
                    "type": "array",
                    "items": { "type": "string", "format": "uuid" }
                  },
                  "action_name": { "type": "string" }
                }
              }
            }
          }
        },
        "check_dlc": {
          "type": ["object", "null"],
          "description": "Downloadable content items from CheckDlc addon.",
          "required": ["has_dlc", "total_dlc_count", "owned_dlc_count", "items"],
          "properties": {
            "has_dlc": { "type": "boolean" },
            "total_dlc_count": { "type": "integer", "minimum": 0 },
            "owned_dlc_count": { "type": "integer", "minimum": 0 },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["dlc_id", "name", "is_owned"],
                "properties": {
                  "dlc_id": { "type": "string" },
                  "name": { "type": "string" },
                  "description": { "type": ["string", "null"] },
                  "image_url": { "type": ["string", "null"], "format": "uri" },
                  "store_url": { "type": ["string", "null"], "format": "uri" },
                  "is_owned": { "type": "boolean" },
                  "price": { "type": ["string", "null"] },
                  "price_base": { "type": ["string", "null"] }
                }
              }
            }
          }
        },
        "system_checker": {
          "type": ["object", "null"],
          "description": "Hardware system requirements from SystemChecker addon.",
          "required": ["has_requirements"],
          "properties": {
            "has_requirements": { "type": "boolean" },
            "minimum": {
              "type": ["object", "null"],
              "properties": {
                "os": { "type": "array", "items": { "type": "string" } },
                "cpu": { "type": "array", "items": { "type": "string" } },
                "gpu": { "type": "array", "items": { "type": "string" } },
                "ram_bytes": { "type": ["number", "null"] },
                "ram_usage": { "type": ["string", "null"] },
                "storage_bytes": { "type": ["number", "null"] },
                "storage_usage": { "type": ["string", "null"] }
              }
            },
            "recommended": {
              "type": ["object", "null"],
              "properties": {
                "os": { "type": "array", "items": { "type": "string" } },
                "cpu": { "type": "array", "items": { "type": "string" } },
                "gpu": { "type": "array", "items": { "type": "string" } },
                "ram_bytes": { "type": ["number", "null"] },
                "ram_usage": { "type": ["string", "null"] },
                "storage_bytes": { "type": ["number", "null"] },
                "storage_usage": { "type": ["string", "null"] }
              }
            }
          }
        },
        "steam_reviews": {
          "type": ["object", "null"],
          "description": "Cached Steam reviews summary from Steam Reviews Viewer.",
          "required": ["has_reviews"],
          "properties": {
            "has_reviews": { "type": "boolean" },
            "review_score_desc": { "type": ["string", "null"] },
            "review_score": { "type": ["integer", "null"] },
            "total_positive": { "type": ["integer", "null"] },
            "total_negative": { "type": ["integer", "null"] },
            "total_reviews": { "type": ["integer", "null"] }
          }
        },
        "steam_screenshots": {
          "type": ["object", "null"],
          "description": "Store screenshots catalog from Steam Screenshots Viewer.",
          "required": ["has_screenshots"],
          "properties": {
            "has_screenshots": { "type": "boolean" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "thumbnail_url", "full_url"],
                "properties": {
                  "id": { "type": "integer" },
                  "thumbnail_url": { "type": "string", "format": "uri" },
                  "full_url": { "type": "string", "format": "uri" }
                }
              }
            }
          }
        },
        "player_activities": {
          "type": ["object", "null"],
          "description": "Historical milestone timeline logs from PlayerActivities addon.",
          "required": ["has_activities"],
          "properties": {
            "has_activities": { "type": "boolean" },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["date_utc", "activity_type", "activity_name"],
                "properties": {
                  "date_utc": { "type": "string", "format": "date-time" },
                  "activity_type": { "type": "integer" },
                  "activity_name": { "type": "string" },
                  "value": { "type": "number" }
                }
              }
            }
          }
        }
      }
    }
  }
}
